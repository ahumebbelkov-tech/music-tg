<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>🎵 My Music</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      --bg: #17212b;
      --card: #232e3c;
      --accent: #2AABEE;
      --text: #ffffff;
      --subtext: #7f91a4;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    body {
      background: var(--bg);
      color: var(--text);
      padding: 20px;
      padding-bottom: 100px; /* Щоб плеєр не перекривав список */
      min-height: 100vh;
    }
    h1 { font-size: 24px; margin-bottom: 5px; display: flex; align-items: center; gap: 10px; }
    .subtitle { color: var(--subtext); font-size: 14px; margin-bottom: 20px; }
    
    /* Пошук */
    .search-box {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }
    input {
      flex: 1;
      padding: 14px 18px;
      border-radius: 12px;
      border: none;
      background: var(--card);
      color: var(--text);
      font-size: 16px;
      outline: none;
    }
    input::placeholder { color: var(--subtext); }
    button.add-btn {
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 12px;
      padding: 0 20px;
      font-size: 24px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }
    button.add-btn:active { transform: scale(0.95); opacity: 0.8; }

    /* Список треків */
    .playlist { display: flex; flex-direction: column; gap: 10px; }
    .track {
      background: var(--card);
      padding: 15px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: 0.2s;
      border: 1px solid transparent;
    }
    .track:active { transform: scale(0.98); }
    .track.active { border-color: var(--accent); }
    .track-info { display: flex; align-items: center; gap: 15px; overflow: hidden; }
    .track-icon {
      width: 40px; height: 40px;
      background: rgba(42, 171, 238, 0.2);
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }
    .track-name { font-size: 16px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .track-url { font-size: 12px; color: var(--subtext); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .delete-btn {
      background: transparent; border: none; color: #ff6b6b; font-size: 20px; cursor: pointer; padding: 5px;
    }

    /* Нижній плеєр */
    .player-bar {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: #1c2530;
      padding: 15px 20px;
      display: flex;
      align-items: center;
      gap: 15px;
      box-shadow: 0 -5px 20px rgba(0,0,0,0.5);
      z-index: 100;
      border-top: 1px solid #2c3b4e;
    }
    .player-info {
      flex: 1;
      overflow: hidden;
    }
    .player-title { font-size: 14px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .player-status { font-size: 12px; color: var(--subtext); }
    .play-btn {
      width: 50px; height: 50px;
      border-radius: 50%;
      background: var(--accent);
      border: none; color: white; font-size: 20px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
    }
    .play-btn:active { transform: scale(0.9); }
    audio { display: none; }

    /* Екран "порожньо" */
    .empty-state { text-align: center; color: var(--subtext); margin-top: 50px; font-size: 15px; line-height: 1.5; }
  </style>
</head>
<body>

  <h1>🎵 Music</h1>
  <div class="subtitle">Вставляй посилання на mp3 і слухай</div>

  <div class="search-box">
    <input type="text" id="urlInput" placeholder="https://.../track.mp3" />
    <button class="add-btn" onclick="addTrack()">+</button>
  </div>

  <div class="playlist" id="playlist">
    <div class="empty-state" id="emptyState">
      Тут поки порожньо.<br>Додай перший трек вище! 👆
    </div>
  </div>

  <div class="player-bar">
    <div class="player-info">
      <div class="player-title" id="playerTitle">Нічого не грає</div>
      <div class="player-status" id="playerStatus">Обери трек зі списку</div>
    </div>
    <button class="play-btn" id="playBtn" onclick="togglePlay()">▶</button>
  </div>

  <audio id="audioPlayer"></audio>

  <script>
    // Ініціалізація Telegram WebApp
    const tg = window.Telegram.WebApp;
    tg.expand(); // Розгортаємо на весь екран
    tg.setHeaderColor('#17212b'); // Колір шапки
    tg.setBackgroundColor('#17212b'); // Колір фону

    const audio = document.getElementById('audioPlayer');
    const playlistEl = document.getElementById('playlist');
    const emptyState = document.getElementById('emptyState');
    const playerTitle = document.getElementById('playerTitle');
    const playerStatus = document.getElementById('playerStatus');
    const playBtn = document.getElementById('playBtn');

    let tracks = JSON.parse(localStorage.getItem('my_tracks') || '[]');
    let currentTrackIndex = -1;

    // Відображення списку
    function renderPlaylist() {
      // Очищаємо все, крім emptyState
      Array.from(playlistEl.children).forEach(child => {
        if (child.id !== 'emptyState') child.remove();
      });

      if (tracks.length === 0) {
        emptyState.style.display = 'block';
        return;
      }
      emptyState.style.display = 'none';

      tracks.forEach((track, index) => {
        const div = document.createElement('div');
        div.className = `track ${index === currentTrackIndex ? 'active' : ''}`;
        
        // Витягуємо назву з посилання (остання частина)
        let name = track.url.split('/').pop().split('?')[0] || 'Трек ' + (index + 1);
        if (name.length > 25) name = name.substring(0, 25) + '...';

        div.innerHTML = `
          <div class="track-info">
            <div class="track-icon">🎵</div>
            <div style="min-width:0">
              <div class="track-name">${name}</div>
              <div class="track-url">${track.url}</div>
            </div>
          </div>
          <button class="delete-btn" onclick="deleteTrack(event, ${index})">✕</button>
        `;
        
        div.onclick = () => playTrack(index);
        playlistEl.appendChild(div);
      });
    }

    // Додавання треку
    function addTrack() {
      const input = document.getElementById('urlInput');
      const url = input.value.trim();
      if (!url) {
        tg.showAlert('Встав посилання на музику!');
        return;
      }
      if (!url.startsWith('http')) {
        tg.showAlert('Посилання має починатися з http:// або https://');
        return;
      }

      tracks.push({ url: url });
      localStorage.setItem('my_tracks', JSON.stringify(tracks));
      input.value = '';
      renderPlaylist();
      tg.HapticFeedback.impactOccurred('light'); // Вібрація
    }

    // Видалення
    function deleteTrack(event, index) {
      event.stopPropagation();
      tracks.splice(index, 1);
      if (currentTrackIndex === index) {
        audio.pause();
        currentTrackIndex = -1;
        playerTitle.innerText = 'Нічого не грає';
        playerStatus.innerText = 'Обери трек зі списку';
        playBtn.innerText = '▶';
      }
      localStorage.setItem('my_tracks', JSON.stringify(tracks));
      renderPlaylist();
    }

    // Відтворення
    function playTrack(index) {
      if (currentTrackIndex === index && !audio.paused) {
        togglePlay();
        return;
      }

      currentTrackIndex = index;
      audio.src = tracks[index].url;
      audio.play().then(() => {
        let name = tracks[index].url.split('/').pop().split('?')[0];
        playerTitle.innerText = name;
        playerStatus.innerText = 'Грає зараз';
        playBtn.innerText = '⏸';
        renderPlaylist();
        tg.HapticFeedback.impactOccurred('medium');
      }).catch(err => {
        tg.showAlert('Помилка відтворення. Можливо, посилання не пряме на mp3.');
        console.error(err);
      });
    }

    // Пауза / Плей
    function togglePlay() {
      if (currentTrackIndex === -1) {
        tg.showAlert('Спочатку додай та вибери трек!');
        return;
      }
      if (audio.paused) {
        audio.play();
        playBtn.innerText = '⏸';
        playerStatus.innerText = 'Грає зараз';
      } else {
        audio.pause();
        playBtn.innerText = '▶';
        playerStatus.innerText = 'Пауза';
      }
    }

    // Кінець треку
    audio.onended = () => {
      playBtn.innerText = '▶';
      playerStatus.innerText = 'Завершено';
      // Автоперехід на наступний
      if (currentTrackIndex < tracks.length - 1) {
        playTrack(currentTrackIndex + 1);
      }
    };

    // Старт
    renderPlaylist();
  </script>
</body>
</html>
